# Referência para configuração local do servidor. Nunca use valores reais no Git.
# URL pública da API consumida pelo frontend (não é segredo).
VITE_API_URL=

# Não prefixar segredos do servidor com VITE_.
DATABASE_URL=
JWT_SECRET=
FRONTEND_ORIGIN=
PORT=3001

# Usadas somente ao executar o bootstrap do primeiro administrador:
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
